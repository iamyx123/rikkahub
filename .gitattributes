# 统一使用 LF 换行
* text=auto eol=lf

# Baseline Profile 生成文件：标记为文本，统一使用 LF 换行，避免 CRLF 抖动
app/src/release/generated/baselineProfiles/*.txt text eol=lf

# Generated bundles contain significant whitespace inside upstream template literals.
app/src/main/assets/intelligent-ui/engine.js linguist-generated=true whitespace=-blank-at-eol
web-ui/public/intelligent-ui/engine.js linguist-generated=true whitespace=-blank-at-eol
